# <%# app/views/home/index.html.erb %>

<% if user_signed_in? %>
  <!-- Logged in user view -->
  <div class="container">
    <h2>Welcome back, <%= current_user.username %>!</h2>
    
    <section class="featured-creators">
      <h3>Featured Creators</h3>
      <div class="row">
        <% @featured_creators.each do |creator| %>
          <%= render 'creators/creator_card', creator: creator %>
        <% end %>
      </div>
    </section>

    <section class="trending-posts">
      <h3>Trending Content</h3>
      <div class="row">
        <% @trending_posts.each do |post| %>
          <%= render 'posts/card', post: post %>
        <% end %>
      </div>
    </section>
  </div>
<% else %>
  <!-- Guest visitor view -->
  <div class="hero-section">
    <div class="container">
      <h1>Discover Exclusive Content</h1>
      <p>Join thousands of creators and fans connecting directly</p>
      
      <div class="cta-buttons">
        <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-primary btn-lg" %>
        <%= link_to "Browse Creators", profiles_path, class: "btn btn-outline-primary btn-lg" %>
      </div>
    </div>
  </div>

  <div class="container">
    <section class="popular-creators">
      <h2>Popular Creators</h2>
      <div class="row">
        <% @popular_creators.each do |creator| %>
          <%= render 'creators/creator_card', creator: creator %>
        <% end %>
      </div>
    </section>
  </div>
<% end %>