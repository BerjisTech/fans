<div id="<%= dom_id medium %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Post:</strong>
    <%= medium.post_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Media data:</strong>
    <%= medium.media_data %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Media type:</strong>
    <%= medium.media_type %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Position:</strong>
    <%= medium.position %>
  </div>
</div>
