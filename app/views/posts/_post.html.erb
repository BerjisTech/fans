<div id="<%= dom_id post %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">User:</strong>
    <%= post.user_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Title:</strong>
    <%= post.title %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= post.description %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Is public:</strong>
    <%= post.is_public? ? "Yes" : "No" %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Is paid:</strong>
    <%= post.is_paid? ? "Yes" : "No" %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Price:</strong>
    <%= post.price %>
  </div>
</div>
