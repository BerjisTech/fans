<%= form_with(model: profile, class: "contents") do |form| %>
  <% if profile.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(profile.errors.count, "error") %> prohibited this profile from being saved:</h2>

      <ul class="list-disc ml-6">
        <% profile.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :user_id %>
    <%= form.text_field :user_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": profile.errors[:user_id].none?, "border-red-400 focus:outline-red-600": profile.errors[:user_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :display_name %>
    <%= form.text_field :display_name, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": profile.errors[:display_name].none?, "border-red-400 focus:outline-red-600": profile.errors[:display_name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :about %>
    <%= form.textarea :about, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": profile.errors[:about].none?, "border-red-400 focus:outline-red-600": profile.errors[:about].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :cover_photo_data %>
    <%= form.textarea :cover_photo_data, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": profile.errors[:cover_photo_data].none?, "border-red-400 focus:outline-red-600": profile.errors[:cover_photo_data].any?}] %>
  </div>

  <div class="my-5 flex items-center gap-2">
    <%= form.label :is_creator %>
    <%= form.checkbox :is_creator, class: ["block shadow-sm rounded-md border order-first h-5 w-5", {"border-gray-400 focus:outline-blue-600": profile.errors[:is_creator].none?, "border-red-400 focus:outline-red-600": profile.errors[:is_creator].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
