<div id="<%= dom_id profile %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">User:</strong>
    <%= profile.user_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Display name:</strong>
    <%= profile.display_name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">About:</strong>
    <%= profile.about %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Cover photo data:</strong>
    <%= profile.cover_photo_data %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Is creator:</strong>
    <%= profile.is_creator? ? "Yes" : "No" %>
  </div>
</div>
