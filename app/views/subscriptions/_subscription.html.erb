<div id="<%= dom_id subscription %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">User:</strong>
    <%= subscription.user_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Subscription plan:</strong>
    <%= subscription.subscription_plan_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Start date:</strong>
    <%= subscription.start_date %>
  </div>
  <div>
    <strong class="block font-medium mb-1">End date:</strong>
    <%= subscription.end_date %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Status:</strong>
    <%= subscription.status %>
  </div>
</div>
